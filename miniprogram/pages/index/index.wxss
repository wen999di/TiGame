.page { min-height: 100vh; padding: 28rpx 28rpx 80rpx; box-sizing: border-box; background: radial-gradient(circle at 20% 0%, #15334b 0, #07111f 42%, #050b13 100%); }
.topbar { display:flex; align-items:center; justify-content:space-between; margin: 8rpx 4rpx 28rpx; }
.brand { display:block; font-size:42rpx; font-weight:900; letter-spacing:-1rpx; }.sub { display:block; color:#93a7b8; font-size:22rpx; margin-top:2rpx; }
.status { border:1rpx solid #33485a; border-radius:999rpx; padding:10rpx 18rpx; font-size:20rpx; color:#9eb2c1; }.status.open { color:#a6c0a2; border-color:#59745a; }.status.connecting { color:#e3c56f; }
.screen { display:flex; flex-direction:column; gap:22rpx; }.center-screen { min-height:72vh; justify-content:center; }.card { background:rgba(13,29,45,.88); border:1rpx solid rgba(169,184,201,.16); border-radius:28rpx; padding:28rpx; box-shadow:0 18rpx 48rpx rgba(0,0,0,.18); }
.hero { padding:42rpx 30rpx; }.eyebrow { display:block; color:#e3c56f; font-size:19rpx; font-weight:800; letter-spacing:3rpx; margin-bottom:12rpx; }.title { display:block; font-size:52rpx; font-weight:900; line-height:1.12; }.desc { display:block; color:#a9b8c9; font-size:26rpx; line-height:1.6; margin-top:18rpx; }.section-title { display:block; font-size:31rpx; font-weight:850; margin-bottom:24rpx; }
.profile-row,.player-row,.setting-row,.settlement { display:flex; align-items:center; gap:18rpx; }.profile-fields,.player-main { flex:1; min-width:0; }.player-row { padding:18rpx 0; border-bottom:1rpx solid rgba(169,184,201,.11); }.player-row:last-child { border-bottom:0; }.player-name { display:block; font-size:27rpx; font-weight:750; }.hint { display:block; color:#879bac; font-size:21rpx; line-height:1.45; margin-top:6rpx; }
.avatar-button { width:112rpx; height:112rpx; padding:0; border-radius:50%; background:transparent; border:0; line-height:1; }.avatar-button::after { border:0; }.avatar-img,.avatar-fallback { width:72rpx; height:72rpx; border-radius:50%; background:#9fd4c0; color:#07111f; display:flex; align-items:center; justify-content:center; font-weight:900; font-size:28rpx; flex:none; overflow:hidden; }.avatar-img.big,.avatar-fallback.big { width:112rpx; height:112rpx; font-size:38rpx; }.faded { opacity:.35; filter:grayscale(1); }
.input { height:88rpx; box-sizing:border-box; width:100%; border:1rpx solid #33485a; background:#07111f; border-radius:18rpx; padding:0 22rpx; color:#f5ebdd; font-size:28rpx; }.room-code { text-align:center; font-size:46rpx; font-weight:900; letter-spacing:8rpx; margin:12rpx 0 18rpx; }
button.primary,button.secondary,button.ghost,button.danger-outline { height:92rpx; border-radius:20rpx; font-size:28rpx; font-weight:800; display:flex; align-items:center; justify-content:center; }.primary { background:#e96b5f !important; color:#fff !important; border:0; }.secondary { background:#193147 !important; color:#f5ebdd !important; border:1rpx solid #35506a; }.ghost { background:transparent !important; color:#9eb2c1 !important; border:0; }.danger-outline { background:transparent !important; color:#e99990 !important; border:1rpx solid rgba(233,107,95,.45); }.small { height:64rpx !important; font-size:22rpx !important; padding:0 22rpx; }.tiny { height:56rpx !important; line-height:56rpx !important; padding:0 18rpx; margin:0; border-radius:14rpx; font-size:20rpx !important; flex:none; }.danger { background:#47212b !important; color:#f3aaa2 !important; border:1rpx solid #6d3440; }
.room-head { display:flex; justify-content:space-between; align-items:center; }.room-id { display:block; font-size:44rpx; font-weight:900; letter-spacing:4rpx; }.share-mini { width:auto; margin:0; padding:0 24rpx; height:64rpx; line-height:64rpx; border-radius:16rpx; background:#1b344b; color:#f5ebdd; font-size:22rpx; }.notice { display:flex; align-items:center; justify-content:space-between; gap:18rpx; padding:20rpx 24rpx; border-radius:18rpx; background:rgba(227,197,111,.12); color:#e3c56f; font-size:23rpx; }
.game-button { display:flex; align-items:center; gap:18rpx; width:100%; min-height:104rpx; margin:14rpx 0; padding:18rpx 22rpx; background:#0b1b2b; color:#f5ebdd; border:1rpx solid #263c51; border-radius:20rpx; text-align:left; }.game-symbol { font-size:44rpx; }.game-name { display:block; font-size:27rpx; font-weight:800; }
.waiting-dot { display:block; text-align:center; color:#e3c56f; font-size:54rpx; margin-bottom:14rpx; }.pending-card { text-align:center; }.secret-card { text-align:center; padding:40rpx 28rpx; }.secret-word { display:block; font-size:48rpx; font-weight:900; line-height:1.25; margin:18rpx 0; }.muted { color:#70879a; font-size:30rpx; }.setting-row { justify-content:space-between; padding:16rpx 0; }.stepper { display:flex; align-items:center; gap:22rpx; }.stepper button { width:62rpx; height:62rpx; line-height:58rpx; padding:0; border-radius:16rpx; background:#173049; color:#fff; }.stepper.large { justify-content:center; font-size:42rpx; margin:24rpx 0 34rpx; }.scope-row,.action-row,.two-col { display:flex; gap:12rpx; }.scope-row { margin:18rpx 0 28rpx; }.chip { flex:1; height:68rpx; line-height:68rpx; padding:0; border-radius:999rpx; background:#13283b; color:#91a5b7; font-size:22rpx; }.chip.active { background:#5b4d28; color:#f0d88f; border:1rpx solid #8d7740; }
.result-main { display:block; font-size:34rpx; font-weight:900; margin:8rpx 0 18rpx; }.reveal,.result-box { display:flex; flex-direction:column; gap:10rpx; padding:20rpx; border-radius:16rpx; background:#07111f; margin:18rpx 0; }.challenge-player { padding:8rpx 0 20rpx; border-bottom:1rpx solid rgba(169,184,201,.11); }.challenge-card { display:block; color:#e3c56f; font-size:24rpx; margin-top:8rpx; }.action-row { justify-content:flex-end; margin-top:10rpx; }.score { display:block; font-size:30rpx; font-weight:900; margin-top:4rpx; }.positive { color:#9fd4c0; }.negative { color:#f08b80; }.transfer-box button { margin-top:14rpx; }.collect { padding:18rpx 0; border-bottom:1rpx solid rgba(169,184,201,.11); font-size:24rpx; }.two-col button { flex:1; }.settlement { justify-content:space-between; padding:16rpx 0; border-bottom:1rpx solid rgba(169,184,201,.11); }
.modal-mask { position:fixed; inset:0; z-index:99; display:flex; align-items:center; justify-content:center; padding:36rpx; background:rgba(0,0,0,.72); }.modal { width:100%; text-align:center; box-sizing:border-box; }
button[disabled] { opacity:.36; }
