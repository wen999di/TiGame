<view class="page">
  <view class="topbar">
    <view>
      <text class="brand">TiGame</text>
      <text class="sub">聚会小游戏</text>
    </view>
    <view wx:if="{{session}}" class="status {{socketStatus}}">{{socketStatus === 'open' ? '已连接' : socketStatus === 'connecting' ? '连接中' : '重连中'}}</view>
  </view>

  <view wx:if="{{screen === 'home'}}" class="screen">
    <view class="hero card">
      <text class="eyebrow">WECHAT MINI PROGRAM</text>
      <text class="title">一部手机，就能开局</text>
      <text class="desc">与网页版使用同一套 TiGame 房间和 Cloudflare Worker 后端。</text>
    </view>

    <view class="card profile-card">
      <text class="section-title">你的微信资料</text>
      <view class="profile-row">
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{profile.avatarPreview}}" class="avatar-img big" src="{{profile.avatarPreview}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback big">{{profileInitial || '+'}}</view>
        </button>
        <view class="profile-fields">
          <input class="input" type="nickname" maxlength="12" value="{{profile.nickName}}" bindinput="onNicknameInput" placeholder="点击填写微信昵称" />
          <text class="hint">头像通过微信 chooseAvatar，昵称通过 nickname 输入能力获取</text>
        </view>
      </view>
    </view>

    <button class="primary" bindtap="goCreate">创建房间</button>
    <button class="secondary" bindtap="goJoin">加入房间</button>
  </view>

  <view wx:elif="{{screen === 'create'}}" class="screen">
    <view class="card">
      <text class="section-title">创建房间</text>
      <text class="desc">将以「{{profile.nickName || '未填写昵称'}}」作为房主。</text>
      <button class="primary" bindtap="createRoom">立即创建</button>
      <button class="ghost" bindtap="goHome">返回</button>
    </view>
  </view>

  <view wx:elif="{{screen === 'join'}}" class="screen">
    <view class="card">
      <text class="section-title">加入房间</text>
      <input class="input room-code" value="{{roomInput}}" bindinput="onRoomInput" maxlength="7" placeholder="ABC-123" />
      <text class="hint">将以「{{profile.nickName || '未填写昵称'}}」申请加入。</text>
      <button class="primary" bindtap="joinRoom">发送加入申请</button>
      <button class="ghost" bindtap="goHome">返回</button>
    </view>
  </view>

  <view wx:elif="{{screen === 'pending'}}" class="screen center-screen">
    <view class="card pending-card">
      <text class="waiting-dot">●</text>
      <text class="section-title">等待房主确认</text>
      <text class="desc">房间 {{session.roomId}} · 房主同意后会自动进入。</text>
      <button class="secondary" bindtap="cancelJoin">取消申请</button>
    </view>
  </view>

  <block wx:elif="{{screen === 'lobby' && room}}">
    <view class="screen">
      <view class="room-head card">
        <view><text class="eyebrow">ROOM</text><text class="room-id">{{room.roomId}}</text></view>
        <button class="share-mini" open-type="share">分享</button>
      </view>

      <view wx:if="{{isHost && room.hostInLobby}}" class="notice">
        <text>当前仍在进行：{{ongoingGameName}}</text>
        <button class="small primary" bindtap="hostReturnGame">返回游戏</button>
      </view>

      <view class="card">
        <text class="section-title">玩家 {{playersView.length}} / 16</text>
        <view class="player-row" wx:for="{{playersView}}" wx:key="id">
          <image wx:if="{{item.avatarSrc}}" class="avatar-img" src="{{item.avatarSrc}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback">{{item.initial}}</view>
          <view class="player-main"><text class="player-name">{{item.name}}</text><text class="hint">{{item.isMe ? '你' : (item.online ? '在线' : '离线')}}{{item.id === room.hostId ? ' · 房主' : ''}}</text></view>
          <button wx:if="{{item.canKick}}" class="tiny danger" data-playerid="{{item.id}}" bindtap="kickPlayer">移出</button>
        </view>
      </view>

      <view wx:if="{{isHost && pendingView.length}}" class="card">
        <text class="section-title">加入申请 {{pendingView.length}}</text>
        <view class="player-row" wx:for="{{pendingView}}" wx:key="id">
          <image wx:if="{{item.avatarSrc}}" class="avatar-img" src="{{item.avatarSrc}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback">{{item.initial}}</view>
          <view class="player-main"><text class="player-name">{{item.playerName}}</text></view>
          <button class="tiny secondary" data-playerid="{{item.id}}" bindtap="rejectJoin">拒绝</button>
          <button class="tiny primary" data-playerid="{{item.id}}" bindtap="approveJoin">同意</button>
        </view>
      </view>

      <view wx:if="{{isHost && !room.hostInLobby}}" class="card">
        <text class="section-title">选择游戏</text>
        <button class="game-button" wx:for="{{gameList}}" wx:key="id" data-gameid="{{item.id}}" bindtap="enterGame" disabled="{{playersView.length < item.minPlayers}}">
          <text class="game-symbol">{{item.symbol}}</text><view><text class="game-name">{{item.name}}</text><text class="hint">至少 {{item.minPlayers}} 人</text></view>
        </button>
      </view>

      <button class="danger-outline" bindtap="leaveRoom">{{isHost ? '结束房间' : '离开房间'}}</button>
    </view>
  </block>

  <block wx:elif="{{screen === 'game' && room && room.game}}">
    <view class="screen">
      <view class="room-head card">
        <view><text class="eyebrow">{{ongoingGameName}}</text><text class="room-id">{{room.roomId}}</text></view>
        <button wx:if="{{isHost}}" class="share-mini" bindtap="hostInvite">邀请玩家</button>
      </view>

      <!-- 谁是卧底 -->
      <block wx:if="{{room.game.kind === 'undercover'}}">
        <view wx:if="{{room.game.phase === 'SETUP'}}" class="card">
          <text class="section-title">游戏设置</text>
          <view class="setting-row"><text>卧底</text><view class="stepper"><button data-key="undercover" data-delta="-1" bindtap="changeUcNumber" disabled="{{!isHost}}">−</button><text>{{ucSettings.undercover}}</text><button data-key="undercover" data-delta="1" bindtap="changeUcNumber" disabled="{{!isHost}}">+</button></view></view>
          <view class="setting-row"><text>白板</text><view class="stepper"><button data-key="blank" data-delta="-1" bindtap="changeUcNumber" disabled="{{!isHost}}">−</button><text>{{ucSettings.blank}}</text><button data-key="blank" data-delta="1" bindtap="changeUcNumber" disabled="{{!isHost}}">+</button></view></view>
          <view class="scope-row">
            <button class="chip {{ucScope1 ? 'active' : ''}}" data-scope="1" bindtap="toggleUcScope" disabled="{{!isHost}}">轻松</button>
            <button class="chip {{ucScope2 ? 'active' : ''}}" data-scope="2" bindtap="toggleUcScope" disabled="{{!isHost}}">标准</button>
            <button class="chip {{ucScope3 ? 'active' : ''}}" data-scope="3" bindtap="toggleUcScope" disabled="{{!isHost}}">烧脑</button>
          </view>
          <button wx:if="{{isHost}}" class="primary" bindtap="startUndercover">开始游戏</button>
          <text wx:else class="hint">等待房主开始</text>
        </view>

        <view wx:if="{{room.game.phase !== 'SETUP'}}" class="card secret-card">
          <text class="eyebrow">你的词语</text>
          <text wx:if="{{secretCard}}" class="secret-word">{{secretCard.isBlank ? '白板' : secretCard.word}}</text>
          <text wx:else class="secret-word muted">观战 / 等待下一局</text>
          <text wx:if="{{secretCard && secretCard.category}}" class="hint">{{secretCard.category}}</text>
        </view>

        <view class="card">
          <text class="section-title">玩家状态</text>
          <view class="player-row" wx:for="{{playersView}}" wx:key="id">
            <image wx:if="{{item.avatarSrc}}" class="avatar-img {{item.eliminated ? 'faded' : ''}}" src="{{item.avatarSrc}}" mode="aspectFill" />
            <view wx:else class="avatar-fallback {{item.eliminated ? 'faded' : ''}}">{{item.initial}}</view>
            <view class="player-main"><text class="player-name">{{item.name}}</text><text class="hint">{{item.eliminated ? '已出局' : item.voteReady ? '已准备投票' : item.voted ? '已投票' : '游戏中'}}</text></view>
            <button wx:if="{{room.game.phase === 'VOTING' && !ucVoted && !item.isMe && !item.eliminated}}" class="tiny primary" data-playerid="{{item.id}}" bindtap="votePlayer">投他</button>
          </view>
        </view>

        <button wx:if="{{room.game.phase === 'PLAYING'}}" class="primary" bindtap="toggleVoteReady">{{ucReady ? '取消准备' : '我准备投票'}}</button>
        <view wx:if="{{room.game.phase === 'VOTING'}}" class="notice"><text>{{ucVoted ? '你的投票已提交' : '请选择一名玩家投票'}}</text></view>
        <view wx:if="{{room.game.phase === 'REVEALED' && room.game.voteResult}}" class="card">
          <text class="section-title">本轮结果</text>
          <text class="result-main">{{room.game.voteResult.eliminatedPlayerName ? room.game.voteResult.eliminatedPlayerName + ' 被淘汰' : '本轮无人被淘汰'}}</text>
          <text wx:if="{{room.game.voteResult.tie}}" class="hint">最高票平票，服务器已随机决定结果</text>
          <view wx:if="{{room.game.voteResult.reveal}}" class="reveal"><text>平民词：{{room.game.voteResult.reveal.normalWord}}</text><text>卧底词：{{room.game.voteResult.reveal.undercoverWord}}</text></view>
          <button wx:if="{{room.game.winner && isHost}}" class="primary" bindtap="restartUndercover">返回大厅</button>
          <button wx:elif="{{!room.game.winner}}" class="primary" bindtap="toggleNextRound">{{ucNextReady ? '取消下一局准备' : '准备下一局'}}</button>
        </view>
      </block>

      <!-- 不要做挑战 -->
      <block wx:if="{{room.game.kind === 'challenge'}}">
        <view wx:if="{{room.game.phase === 'SETUP'}}" class="card">
          <text class="section-title">初始生命</text>
          <view class="stepper large"><button data-delta="-1" bindtap="changeChallengeLives" disabled="{{!isHost}}">−</button><text>{{challengeLives}}</text><button data-delta="1" bindtap="changeChallengeLives" disabled="{{!isHost}}">+</button></view>
          <button wx:if="{{isHost}}" class="primary" bindtap="startChallenge">开始游戏</button>
        </view>
        <view wx:else class="card">
          <text class="section-title">玩家禁忌</text>
          <text class="hint">你看不到自己的牌，其他人的牌公开。</text>
          <view class="challenge-player" wx:for="{{playersView}}" wx:key="id">
            <view class="player-row">
              <image wx:if="{{item.avatarSrc}}" class="avatar-img {{item.eliminated ? 'faded' : ''}}" src="{{item.avatarSrc}}" mode="aspectFill" />
              <view wx:else class="avatar-fallback {{item.eliminated ? 'faded' : ''}}">{{item.initial}}</view>
              <view class="player-main"><text class="player-name">{{item.name}} · ❤ {{item.life}}</text><text class="challenge-card">{{item.isMe ? '你的牌对自己隐藏' : (item.challengeCard || '已出局')}}</text></view>
            </view>
            <view wx:if="{{isHost && room.game.phase === 'PLAYING' && !item.eliminated}}" class="action-row">
              <button class="tiny danger" data-action="penalize" data-playerid="{{item.id}}" bindtap="challengeAction">犯规 -1</button>
              <button class="tiny secondary" data-action="swap" data-playerid="{{item.id}}" bindtap="challengeAction">换牌</button>
              <button class="tiny primary" data-action="reward" data-playerid="{{item.id}}" bindtap="challengeAction">奖励 +1</button>
            </view>
          </view>
          <view wx:if="{{room.game.phase === 'ENDED'}}" class="result-box"><text class="result-main">游戏结束</text><button wx:if="{{isHost}}" class="primary" bindtap="restartChallenge">再来一局</button></view>
        </view>
      </block>

      <!-- 麻将计分 -->
      <block wx:if="{{room.game.kind === 'mahjong'}}">
        <view class="card">
          <text class="section-title">当前分数</text>
          <view class="player-row score-row" wx:for="{{playersView}}" wx:key="id">
            <image wx:if="{{item.avatarSrc}}" class="avatar-img" src="{{item.avatarSrc}}" mode="aspectFill" />
            <view wx:else class="avatar-fallback">{{item.initial}}</view>
            <view class="player-main"><text class="player-name">{{item.name}}</text><text class="score {{item.score >= 0 ? 'positive' : 'negative'}}">{{item.score > 0 ? '+' : ''}}{{item.score}}</text></view>
            <button wx:if="{{!item.isMe && room.game.phase === 'PLAYING'}}" class="tiny secondary" data-playerid="{{item.id}}" bindtap="selectTransferTarget">给分</button>
          </view>
        </view>
        <view wx:if="{{room.game.phase === 'PLAYING'}}" class="card transfer-box">
          <text class="section-title">{{transferTarget ? '给 ' + transferTarget.name + ' 分' : '输入分数'}}</text>
          <input class="input" type="number" value="{{pointsInput}}" bindinput="onPointsInput" placeholder="1–99999" />
          <button wx:if="{{transferTarget}}" class="primary" bindtap="sendTransfer">确认给分</button>
          <button class="secondary" bindtap="collectFromAll">向所有人收取</button>
        </view>
        <view wx:if="{{pendingCollectsView.length}}" class="card">
          <text class="section-title">待确认收取</text>
          <view class="collect" wx:for="{{pendingCollectsView}}" wx:key="id">
            <text>{{item.collectorName}} 向每人收取 {{item.points}} 分</text>
            <view wx:if="{{item.needsMyVote}}" class="action-row">
              <button class="tiny secondary" data-collectid="{{item.id}}" data-approve="false" bindtap="voteCollect">拒绝</button>
              <button class="tiny primary" data-collectid="{{item.id}}" data-approve="true" bindtap="voteCollect">确认</button>
            </view>
          </view>
        </view>
        <view wx:if="{{room.game.phase === 'PLAYING'}}" class="two-col">
          <button class="secondary" bindtap="toggleMahjongReset">{{mahjongResetReady ? '取消重置' : '准备重置'}}</button>
          <button class="primary" bindtap="toggleMahjongSettle">{{mahjongSettleReady ? '取消结账' : '准备结账'}}</button>
        </view>
        <view wx:if="{{room.game.phase === 'SETTLING' && room.game.settlement}}" class="card">
          <text class="section-title">结账建议</text>
          <view class="settlement" wx:for="{{room.game.settlement.transfers}}" wx:key="index"><text>{{item.fromPlayerName}} → {{item.toPlayerName}}</text><strong>{{item.points}} 分</strong></view>
        </view>
      </block>

      <button wx:if="{{isHost}}" class="danger-outline" bindtap="backToLobby">结束游戏并返回大厅</button>
      <button wx:else class="danger-outline" bindtap="leaveRoom">离开房间</button>
    </view>
  </block>

  <view wx:if="{{lostCard}}" class="modal-mask">
    <view class="modal card"><text class="eyebrow">你刚失去的牌</text><text class="secret-word">{{lostCard.action}}</text><button class="primary" bindtap="dismissLostCard">知道了</button></view>
  </view>
</view>
