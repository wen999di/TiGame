{
  "name": "tigame",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "corepack pnpm install --frozen-lockfile",
    "dev": "vite",
    "build": "node scripts/build-cloudflare.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "start": "vinext start",
    "test": "node scripts/build-cloudflare.mjs && node --experimental-strip-types --test tests/deal-cards.test.mjs tests/room-logic.test.mjs tests/challenge.test.mjs tests/mahjong.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:miniprogram": "node --check miniprogram/app.js && node --check miniprogram/config.js && node --check miniprogram/utils/api.js && node --check miniprogram/utils/profile.js && node --check miniprogram/pages/index/index.js",
    "dev:miniprogram": "node scripts/open-wechat-devtools.mjs",
    "dev:miniprogram:check": "node scripts/open-wechat-devtools.mjs --check"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "motion": "^12.43.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "TiGame｜在线房间",
  "packageManager": "pnpm@10.15.0"
}
